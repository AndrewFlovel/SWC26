# Results source: mundial2026.mikeguerra4.com (/api/matches/results)
#
# Everything here is OPTIONAL. By default the backend calls the public results
# endpoint with browser-like headers and needs no credentials. Only set these
# if your network reaches the host but it gates server-side requests (HTTP 401).
#
# Copy to ".env" (same dir as docker-compose.yml) and fill in as needed:
#   cp .env.example .env

# Override the results endpoint URL (defaults to the public one).
# MUNDIAL_RESULTS_URL=https://mundial2026.mikeguerra4.com/api/matches/results

# Raw Cookie header the browser sends to /api/matches/results, if the endpoint
# is session-gated. In DevTools: Network -> the "results" request -> Headers ->
# Request Headers -> copy the full "Cookie:" value here.
# MUNDIAL_COOKIE=.AspNetCore.Session=...; other=...

# Bearer token, if the API uses one instead of a cookie.
# MUNDIAL_TOKEN=eyJhbGciOi...
